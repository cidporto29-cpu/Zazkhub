-- Lógica do slider (drag)
local draggingSlider = false
local function updateSlider(input)
    local posX = input.Position.X
    local trackAbs = track.AbsolutePosition.X
    local trackSize = track.AbsoluteSize.X
    if trackSize <= 0 then return end
    local pct = math.clamp((posX - trackAbs) / trackSize, 0, 1)
    local valor = math.floor(16 + (1000 - 16) * pct)
    SpeedBoost.Velocidade = valor
    valorLabel.Text = tostring(valor)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    knob.Position = UDim2.new(pct, -8, 0.5, -8)
    if SpeedBoost.Ativo then
        local c = localPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = valor end
    end
end

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = true
        updateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = false
    end
end)

-- Lista de ovos
local selectedUid = nil
local ovosLista = {}

local function limparLista()
    for _, row in ipairs(ovosLista) do
        pcall(function() row:Destroy() end)
    end
    ovosLista = {}
end

local function atualizarLista()
    limparLista()
    local infos = {}
    for _, rec in ipairs(snapshot()) do
        infos[#infos + 1] = describe(rec)
    end
    table.sort(infos, function(a, b) return a.Value > b.Value end)

    for i, info in ipairs(infos) do
        local row = criar("TextButton", {
            Size = UDim2.new(1, -8, 0, 26),
            BackgroundColor3 = i % 2 == 0 and Cores.Painel or Cores.Fundo,
            BorderSizePixel = 0,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = Cores.Texto,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  " .. info.Name,
            LayoutOrder = i,
        }, {criar("UICorner", {CornerRadius = UDim.new(0, 4)})})
        row.Parent = scroll

        row.MouseButton1Click:Connect(function()
            selectedUid = info.Uid
            for _, r in ipairs(ovosLista) do
                r.BackgroundColor3 = r == row and Cores.Roxo or (r.LayoutOrder % 2 == 0 and Cores.Painel or Cores.Fundo)
            end
        end)

        table.insert(ovosLista, row)
    end
end

